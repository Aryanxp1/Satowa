# Project LEX Backend Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Fallback Mock Mode
# When true, all AI/analysis endpoints return high-quality mock data without needing real API keys
USE_MOCK=true

# AI Provider Configuration
# Supported providers: gemini, openai
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://lex-app.vercel.app

# Required for real image uploads; never use these server secrets in frontend code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Private demo token, sent as Authorization: Bearer <token>
MEDIA_UPLOAD_TOKEN=

# Writable SQLite path; mount persistent storage in a deployment.
LEX_DB_PATH=./lex.sqlite3
# Model used for two-image comparison when GEMINI_API_KEY is set.
GEMINI_VISION_MODEL=gemini-2.5-flash

# JSON mapping of reviewer names to distinct private tokens, for the demo only.
REVIEWER_TOKENS={"Farhan":"replace-with-long-random-token"}
