# Setowa backend environment variables. Put real secrets only in local .env or host settings.

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOCAL_DEMO=false

# Generic /analyze mock mode. Set false for a real Gemini pilot.
USE_MOCK=true

# AI Provider Configuration
# Reserved setting; the current implementation uses Gemini directly.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Required for real image uploads; never use these server secrets in frontend code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional separate upload token. Leave unset when REVIEWER_TOKENS authorizes media.
MEDIA_UPLOAD_TOKEN=

# Writable SQLite path. Render without a disk will lose this data on restart/redeploy.
LEX_DB_PATH=./lex.sqlite3

# For ENVIRONMENT=pilot, exactly one reviewer token of at least 32 characters is required.
REVIEWER_TOKENS={"Farhan":"replace-with-at-least-32-random-characters"}
