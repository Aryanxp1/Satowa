# Setowa backend environment variables. Put real secrets only in local .env or host settings.

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOCAL_DEMO=false

# Generic /analyze mock mode. Set false for a live pilot.
USE_MOCK=true

# AI Provider Configuration
# NVIDIA is optional. Without a key, use manual review and keyword search.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# Optional legacy Gemini provider; never needed for readiness.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VISION_MODEL=gemini-3.8-flash

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Required for real image uploads; never use these server secrets in frontend code.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional separate upload token. Leave unset when REVIEWER_TOKENS authorizes media.
MEDIA_UPLOAD_TOKEN=

# Writable SQLite path. Render without a disk will lose this data on restart/redeploy.
LEX_DB_PATH=./lex.sqlite3

# For ENVIRONMENT=pilot, exactly one reviewer token of at least 32 characters is required.
REVIEWER_TOKENS={"Aryan":"ptMAR0cW8MYHQda3CgG3uli7HMJ5r8R_WQS_MOyFTsuARg0Lwto6gXwogc-S2rrO"}

# Optional PostgreSQL. Run scripts/migrate_postgres.py before starting.
# Set only in host secret settings; never commit a real connection string.
DATABASE_URL=
